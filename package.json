{
	"name": "@r-table/monorepo",
	"private": true,
	"version": "0.2.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun --cwd packages/examples run dev",
		"build": "bun run build:lib && bun run build:examples",
		"build:lib": "bun --cwd packages/r-table run build",
		"build:examples": "bun --cwd packages/examples run build",
		"clean": "rm -rf packages/*/dist packages/*/build node_modules packages/*/node_modules",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "bun run typecheck:lib && bun run typecheck:examples",
		"typecheck:lib": "bun --cwd packages/r-table run typecheck",
		"typecheck:examples": "bun --cwd packages/examples run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.6",
		"@types/bun": "latest",
		"typescript": "^5"
	}
}
